generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  role      String   // admin, supervisor, viewer
  createdAt DateTime @default(now())
}

model Shift {
  id        String     @id @default(uuid())
  orgId     String
  name      String     // A, B, C
  startTime String
  endTime   String
  operators Operator[]
}

model Operator {
  id           String          @id @default(uuid())
  orgId        String
  employeeCode String
  name         String
  shiftId      String
  shift        Shift           @relation(fields: [shiftId], references: [id])
  isActive     Boolean         @default(true)
  leftOn       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  skills       OperatorSkill[]

  @@unique([orgId, employeeCode])
}

model Skill {
  id          String          @id @default(uuid())
  orgId       String
  code        String
  name        String
  line        String
  criticality Int             @default(2) // 1-3
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  operators   OperatorSkill[]

  @@unique([orgId, code])
}

model OperatorSkill {
  id             String    @id @default(uuid())
  orgId          String
  operatorId     String
  operator       Operator  @relation(fields: [operatorId], references: [id])
  skillId        String
  skill          Skill     @relation(fields: [skillId], references: [id])
  level          Int       // 0-4
  issuedOn       DateTime?
  certifiedUntil DateTime?
  updatedAt      DateTime  @updatedAt
  updatedBy      String?

  @@unique([orgId, operatorId, skillId])
}

model Alert {
  id             String    @id @default(uuid())
  orgId          String
  operatorId     String
  skillId        String
  certifiedUntil DateTime
  severity       String    // expired | critical | warning | notice
  daysRemaining  Int
  status         String    // open | resolved
  firstFlaggedAt DateTime  @default(now())
  lastCheckedAt  DateTime
  resolvedAt     DateTime?
  resolvedReason String?

  @@unique([orgId, operatorId, skillId, certifiedUntil])
}

model SkillHistory {
  id                String    @id @default(uuid())
  orgId             String
  operatorId        String
  skillId           String
  action            String    // CREATE | UPDATE | DELETE | REVERT | SEED
  oldLevel          Int?
  newLevel          Int?
  oldIssuedOn       DateTime?
  newIssuedOn       DateTime?
  oldCertifiedUntil DateTime?
  newCertifiedUntil DateTime?
  changedBy         String?   // User ID
  changedAt         DateTime  @default(now())
  reason            String?
  revertedFromId    String?   // Self-referencing

  @@index([orgId, operatorId, skillId, changedAt])
  @@index([orgId, changedAt])
}

model JobRun {
  id            String    @id @default(uuid())
  orgId         String
  jobName       String
  triggeredBy   String
  asOfDate      DateTime
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String    // ok | error
  flaggedTotal  Int       @default(0)
  newlyFlagged  Int       @default(0)
  resolvedCount Int       @default(0)
  errorMessage  String?
}

model Assignment {
  id             String   @id @default(uuid())
  orgId          String
  operatorId     String
  skillId        String
  shiftId        String
  assignmentDate DateTime
  status         String   // accepted | rejected
  verdict        String   // green | red
  reasonsJson    String   // JSON string
  assignedBy     String?  // User ID
  createdAt      DateTime @default(now())

  @@index([orgId, operatorId, assignmentDate])
  @@index([orgId, skillId, assignmentDate])
}

model AuditLog {
  id          String   @id @default(uuid())
  orgId       String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  changesJson String?
  createdAt   DateTime @default(now())
}
