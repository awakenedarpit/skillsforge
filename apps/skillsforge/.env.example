# This application currently uses SQLite in prisma/schema.prisma.
# The file is created by `npm run db:push` and is ignored by Git.
DATABASE_URL="file:./dev.db"

# Local development only. Do not use these demo values in production.
NEXTAUTH_SECRET="insecure-dev-secret-for-skillsforge"
NEXTAUTH_URL="http://localhost:3011"
INTERNAL_SECRET="shared-secret-for-internal-calls"
REDIS_URL=""
APP_URL="http://localhost:3011"
APP_TIMEZONE="Asia/Kolkata"
APP_TODAY=""
SKILLSFORGE_DEV_AUTH="true"
