# Copy to .env at the repository root. All of these are optional; defaults work locally.

# sqlite:///./skillmatrix.db is resolved relative to the backend folder.
# Postgres: postgres:// or postgresql:// URLs are rewritten to postgresql+psycopg://
DATABASE_URL=sqlite:///./skillmatrix.db

# API port. The dev script passes this to uvicorn. Frontend Vite stays on 5173.
PORT=8000

# Used by today() everywhere "today" is needed. Optional APP_TODAY pins the demo date (YYYY-MM-DD).
APP_TIMEZONE=Asia/Kolkata
# APP_TODAY=

# Shared secret for POST /api/jobs/expiry-check/run from an external scheduler (header X-Job-Secret).
JOB_SECRET=dev-job-secret

# APScheduler cron in APP_TIMEZONE. Default 06:00 every day.
EXPIRY_JOB_CRON=0 6 * * *

# Comma-separated browser origins for CORS. Vite proxies /api in development, so this is for other hosts.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed the database on startup when it has no users.
AUTO_SEED=true

# Domain rules (section 2). Defaults match the spec; override only if you mean to.
QUALIFIED_MIN_LEVEL=2
MIN_COVERAGE=2
EXPIRY_WINDOW_DAYS=30
